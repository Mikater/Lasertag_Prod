#include <IRremote.h>

IRsend irsend;

// Масив інфрачервоних пульсів
unsigned int rawData[] = {
  2400, -550, 1250, -500, 650, -550, 650, -550,
  600, -600, 600, -600, 600, -550, 1250, -550,
  1200, -550, 650, -550, 650, -550, 600, -600,
  600, -600, 600, -550, 1250, -550, 600, -550,
  1250, -550, 1200, -600, 1250, -500, 1250, -550,
  650, -500, 1250, -550, 650, -550, 600, -600, 600
};

int rawDataSize = sizeof(rawData) / sizeof(rawData[0]);

void setup() {
  // Немає необхідності в конфігурації пінів для передачі IR сигналу
}

void loop() {
  // Відправляємо "сирі" інфрачервоні пульси
  irsend.sendRaw(rawData, rawDataSize, 38); // 38 - протокол Sony
  delay(500); // Затримка перед надсиланням наступного сигналу
}
