

void i2cDisp() {
  int gameMode = 1;
  int life = 100;
  display.clearDisplay();
  dispTopLine();
  if (gameMode != 0){
    if( life > 0 ){ 
    DisplayInGame();}
    else {DisplayGameOver();}
  } else {
    DisplayWaitMenu();
  }
  display.display();
}

