<TargetCard>:
    id_text: id_text
    serial_nomber: serial_nomber
    hits_count: hits_count

    size_hint: 0.9, None
    height: "100dp"
    elevation: 1
    md_bg_color: 1, 1, 1, 1
    radius: [8]
    on_touch_down: app.change_screen("Screen1")

    # ID
    MDLabel:
        id: id_text
        text: "ID"
        font_size: "20sp"
        md_bg_color: 0, 0, 0, 0
        size_hint_x: None
        width: "40dp"
        size_hint_y: None
        height: "20dp"
        pos_hint: {"x": 0.05, "top": 0.95}

    # Serial number
    MDLabel:
        id: serial_nomber
        text: "error"
        color: 0, 0.3, 0.3, 1
        font_size: "10sp"
        halign: "right"
        size_hint_x: 0.25
        size_hint_y: None
        height: "20dp"
        md_bg_color: 0, 0, 0, 0
        pos_hint: {"right": 0.98, "top": 0.95}
        shorten: True
        ellipsize: "end"
        shorten_from: "right"

    # Logs
    MDLabel:
        id: hits_count
        text: "14000"
        font_size: "20sp"
        halign: "center"
        size_hint_x: 0.25
        size_hint_y: None
        height: "20dp"
        pos_hint: {"center_x": 0.5, "top": 0.95}
        shorten: True
        ellipsize: "end"
        shorten_from: "right"

    MDBoxLayout:
        orientation: 'horizontal'
        md_bg_color: 0, 0, 0.1, 0.1
        size_hint_x: 0.95
        size_hint_y: 0.6
        pos_hint: {"center_x": 0.5, "center_y": 0.4}
        radius: [5]

        MDBoxLayout:
            orientation: 'vertical'
            MDLabel:
                text: 'Red'
                font_size: "15sp"
                halign: "center"
            MDLabel:
                id: Red_Hits
                text: '0'
                font_size: "20sp"
                halign: "center"

        MDBoxLayout:
            orientation: 'vertical'
            MDLabel:
                text: 'Blue'
                font_size: "15sp"
                halign: "center"
            MDLabel:
                id: Blue_Hits
                text: '0'
                font_size: "20sp"
                halign: "center"

        MDBoxLayout:
            orientation: 'vertical'
            MDLabel:
                text: 'Yell'
                font_size: "15sp"
                halign: "center"
            MDLabel:
                id: Yellow_Hits
                text: '0'
                font_size: "20sp"
                halign: "center"

        MDBoxLayout:
            orientation: 'vertical'
            MDLabel:
                text: 'Green'
                font_size: "15sp"
                halign: "center"
            MDLabel:
                id: Green_Hits
                text: '0'
                font_size: "20sp"
                halign: "center"

<TargetLog>:
    orientation: 'horizontal'
    md_bg_color: 1, 1, 1, 1

    MDAnchorLayout:
        anchor_x: 'center'
        MDLabel:
            id: shooter_id
            text: "ID 2"
            size_hint_y: None
            size_hint_x: None
            height: "20dp"
            width: "40dp"
            font_size: "10sp"

    MDAnchorLayout:
        anchor_x: 'center'
        MDLabel:
            id: shooter_team
            text: "YELL"
            size_hint_y: None
            size_hint_x: None
            height: "20dp"
            width: "33dp"
            font_size: "10sp"

    MDAnchorLayout:
        anchor_x: 'center'
        MDLabel:
            id: hit_damage
            text: "100"
            size_hint_y: None
            size_hint_x: None
            height: "20dp"
            width: "33dp"
            font_size: "10sp"

    MDAnchorLayout:
        anchor_x: 'center'
        MDLabel:
            id: time
            text: "22:06:12:856"
            size_hint_y: None
            size_hint_x: None
            height: "20dp"
            width: "80dp"
            font_size: "10sp"

MDScreen:
    targets_bar: targets_bar
    name: "Screen3"
    MDBoxLayout:
        orientation: 'vertical'
        MDBoxLayout:
            size_hint: 1, None
            height: '60dp'
            orientation: 'horizontal'
            MDLabel:
                padding: 20, 10
                text: "Targets"
                font_size: "20sp"
                halign: "left"
            MDAnchorLayout:
                anchor_x: 'right'
                MDIconButton:
                    id: icon
                    icon: "identifier"
                    on_press: app.update_targets()

        # Таблиця мішеней
        MDScrollView:
            targets_bar: targets_bar
            do_scroll_x: False
            do_scroll_y: True
            bar_width: 0
            MDGridLayout:
                id: targets_bar
                padding: [10]
                spacing: [10]
                cols: 1
                height: self.minimum_height
                row_default_height: 100
                size_hint_y: None
        BotLine: