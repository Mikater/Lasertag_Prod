


MDScreen:
    name: "Screen2"
    MDBoxLayout:
        orientation: 'vertical'
        MDBoxLayout:
            MDScrollView:
                do_scroll_x: False
                do_scroll_y: True
                bar_width: 0
                MDGridLayout:
                    id: obj_bar
                    padding: [10]
                    spacing: [10]
                    cols: 1
                    height: self.minimum_height
                    row_default_height: 100
                    size_hint_y: None
                    PlayerCard:
                    PlayerCard:
            MDScrollView:
                do_scroll_x: False
                do_scroll_y: True
                bar_width: 0
                MDGridLayout:
                    id: obj_bar
                    padding: [10]
                    spacing: [10]
                    cols: 1
                    height: self.minimum_height
                    row_default_height: 100
                    size_hint_y: None
                    PlayerCard:
                    PlayerCard:
        BotLine:


<PlayerCard>
    bg: bg
    id: bg
    elevation: 1
    size_hint: 0.9, None
    height: "100dp"
    md_bg_color: 0.8, 0.8, 0.8, 1
    radius: [8]

    MDFloatLayout:
        size_hint: 0.98, 0.95
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        radius: [8]
        md_bg_color: 1, 1, 1, 1

    MDFillRoundFlatButton:
        id: id
        size_hint: None, None
        md_bg_color: 1, 0, 0, 0.5
        height: "90dp"
        width: "90dp"
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        on_press: root.kill_res_player()
        text: "22"
        halign: 'center'
        font_size: "60sp"

