<TopLine@MDBoxLayout>
    md_bg_color: 102/255, 1, 178/255, 1
    size_hint: 1, None
    height: "100dp"
    MDIcon:
        id: icon
        icon: "chess-rook"
        font_size: "20sp"

    MDLabel:
        id: name_base
        text: "LaserTak"
        font_size: "20sp"
        size_hint_x: .8

    MDIcon:
        id: icon
        icon: "chess-rook"
        font_size: "20sp"



<BaseCard>
    elevation: 1
    size_hint: 0.9, None
    height: "200dp"
    md_bg_color: 1, 1, 1, 1
    radius: [8]
    MDFloatLayout:
        id: bar
        size_hint: .9, .01
        pos_hint: {"center_x": .5, "center_y": .04}
        md_bg_color: 0/255, 213/255, 255/255, 1

    MDIcon:
        id: icon
        icon: "chess-rook"
        pos_hint: {"center_x": .15, "center_y": .5}
        font_size: "120sp"


    MDLabel:
        id: name_base
        text: "Base1"
        font_size: "20sp"
        size_hint_x: .8
        pos_hint: {"center_x": .8, "center_y": .75}

    MDBoxLayout:
        size_hint: None, None
        width: '80dp'
        height: '80dp'
        pos_hint: {"center_x": 0.85, "center_y": 0.75}
        MDAnchorLayout:
            anchor_x: 'right'
            anchor_y: 'center'
            MDLabel:
                id: HP
                text: "100"
                font_size: "20sp"
        MDAnchorLayout:
            anchor_x: 'left'
            anchor_y: 'center'
            MDIcon:
                icon: "heart"

    MDGridLayout:
        spacing: [10]
        cols: 3
        rows: 3
        radius: [8]
        md_bg_color: .3, .3, .3, 0.2
        size_hint: .3, .4
        pos_hint: {"center_x": 0.5, "center_y": 0.3}
        MDAnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            MDIcon:
                icon: "home-lightning-bolt-outline"
        MDAnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            MDIcon:
                icon: "restart"
        MDAnchorLayout:
            anchor_x: 'center'
            anchor_y: 'center'
            MDIcon:
                icon: "shield-check-outline"
        CB:
        CB:
        CB:

    MDFloatLayout:
        radius: [8]
        md_bg_color: .3, .3, .3, 0.2
        size_hint: None, None
        width: '80dp'
        height: '80dp'
        pos_hint: {"center_x": 0.85, "center_y": 0.3}
        MDIconButton:
            pos_hint: {"center_x": .25, "center_y": .75}
            size_hint: None, None
            size: dp(20), dp(20)
            theme_icon_color: "Custom"
            icon_color: 36/255, 134/255, 220/255, 1
            icon: "record"
            style: "standard"
        MDIconButton:
            pos_hint: {"center_x": .25, "center_y": .25}
            size_hint: None, None
            size: dp(20), dp(20)
            theme_icon_color: "Custom"
            icon_color: 247/255, 247/255, 7/255, 1
            icon: "record"
            style: "standard"
        MDIconButton:
            pos_hint: {"center_x": .75, "center_y": .75}
            size_hint: None, None
            size: dp(20), dp(20)
            theme_icon_color: "Custom"
            icon_color: 226/255, 30/255, 30/255, 1
            icon: "record"
            style: "standard"
        MDIconButton:
            pos_hint: {"center_x": .75, "center_y": .25}
            size_hint: None, None
            size: "20dp", "20dp"
            theme_icon_color: "Custom"
            icon_color: 30/255, 226/255, 30/255, 1
            icon: "record"
            style: "standard"


MDScreen:
    name: "Screen1"
    MDBoxLayout:
        orientation: 'vertical'
        MDTopAppBar:
            type_height: "small"
            MDLabel:
                text: "LaserTak"
                font_size: "20sp"
        MDScrollView:
            do_scroll_x: False
            MDGridLayout:
                padding: [10]
                spacing: [10]
                cols: 1
                BaseCard:
                BaseCard:

<CB@MDAnchorLayout>
    anchor_x: 'center'
    anchor_y: 'center'
    Check:

<Check@MDCheckbox>
    group: 'group'
    size_hint: None, None
    size: dp(48), dp(48)